# Hugging Face API Configuration
# Get your free API token from: https://huggingface.co/settings/tokens
HF_API_TOKEN=your_huggingface_api_token_here

# Optional: Use a different model
# HF_MODEL=mistralai/Mistral-7B-Instruct-v0.1  # Default (fast)
# HF_MODEL=meta-llama/Llama-2-7b-chat-hf        # Better quality (slower)
# HF_MODEL=google/flan-t5-base                  # Lighter weight

# Database Configuration (if using PostgreSQL)
# DB_HOST=localhost
# DB_NAME=rag_assistant
# DB_USER=postgres
# DB_PASSWORD=your_password
